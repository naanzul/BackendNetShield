# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO (NetShield)
# ==========================================

# --- SEGURIDAD ---
# Secreto para firmar los JWT. 
# Genera uno nuevo con el comando: 
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui

# Código de arranque para crear al primer administrador sin invitación.
# Solo funciona si la tabla de usuarios está vacía.
ADMIN_BOOTSTRAP_CODE=tu_codigo_de_arranque_aqui

# --- BASE DE DATOS ---
# Formato: mysql://usuario:contraseña@localhost:3306/nombre_base_de_datos
DATABASE_URL=mysql://root:tu_contraseña@localhost:3306/reportes_fraude